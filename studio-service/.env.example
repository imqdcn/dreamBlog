# ===== 必填（缺失时服务启动失败，退出码 1）=====
# Strapi 自定义 API Token（Write_Token，需 dream/story/agent-run 的读写权限）
STUDIO_STRAPI_TOKEN=
# LLM 密钥（LLM_Key）
STUDIO_LLM_API_KEY=
# Owner 登录口令。建议至少 12 个字符：
# 回答中若出现任何密钥取值会被整体替换，口令过短（如 "1"）会误伤大量正常回答。
STUDIO_OWNER_PASSPHRASE=
# 会话签名密钥（HMAC-SHA256）。建议至少 12 个字符，使用随机字符串，生成命令：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STUDIO_SESSION_SECRET=

# ===== 可选 =====
# Backend 地址
STUDIO_STRAPI_URL=http://localhost:1337
# OpenAI 兼容接口
STUDIO_LLM_BASE_URL=https://api.openai.com/v1
STUDIO_LLM_MODEL=gpt-4o-mini
# 每百万 token 单价，用于 estimatedCost
STUDIO_LLM_PRICE_INPUT_PER_M=0
STUDIO_LLM_PRICE_OUTPUT_PER_M=0
# 允许的前端来源，逗号分隔，完全匹配；留空则不放行任何来源
CORS_ORIGIN=http://localhost:3000
# 监听端口
STUDIO_PORT=8787
# 位于反向代理之后时设为 true，登录来源地址取 X-Forwarded-For 最左项
STUDIO_TRUST_PROXY=false
# Agent 最大步数与上下文预算（token 估算）
STUDIO_MAX_STEPS=8
STUDIO_CONTEXT_BUDGET=12000
# 服务器本地时区（日期归属与系统指令中的当前日期）
TZ=Asia/Shanghai
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
