{
  "name": "dream-blog-studio-service",
  "private": true,
  "version": "0.1.0",
  "description": "梦境小屋 Studio_Service：认证、梦境写入、故事生成与 Dream_Agent",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vite-node eval/run-eval.ts",
    "eval:offline": "vite-node eval/run-eval.ts --offline"
  },
  "dependencies": {
    "@hono/node-server": "1.19.18",
    "dotenv": "16.6.1",
    "hono": "4.13.17",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vite-node": "2.1.9",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
