# ===== docker compose 自托管编排用（根目录）=====
# 复制为 .env 后填写。用于 backend + mcp-server + postgres。

# --- Strapi 密钥（用随机值替换）---
# 生成：node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=key1,key2
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme

# --- Postgres ---
DATABASE_NAME=dream_blog
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-this-password

# --- 前端域名（CORS，逗号分隔）---
CORS_ORIGIN=https://your-frontend.example.com

# --- 小智 MCP 接入点 ---
MCP_ENDPOINT=wss://your-xiaozhi-endpoint/mcp_endpoint/mcp/?token=replace-me

# --- MCP Server 写入 Strapi 的 Token（部署后在 Strapi 内创建）---
STRAPI_TOKEN=replace-with-strapi-api-token

# --- LLM 加工 ---
LLM_ENABLED=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

LOG_LEVEL=info

# ===== Studio_Service（梦境小屋与分析助手，仅服务端持有密钥）=====
# 下列敏感变量的值留空，部署时自行填写，不要提交真实值。
# Write_Token：在 Strapi 内由 setup-access 脚本创建，仅首次可见明文
STUDIO_STRAPI_TOKEN=
# LLM 密钥；留空则回退到 LLM_API_KEY
STUDIO_LLM_API_KEY=
# Owner 登录口令，至少 12 个字符（过短会让回答中的密钥脱敏误伤正常内容）
STUDIO_OWNER_PASSPHRASE=
# 会话签名密钥，使用随机 32 字节，生成命令：
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STUDIO_SESSION_SECRET=
# 可选：覆盖 LLM_BASE_URL / LLM_MODEL（留空沿用上面的 LLM_*）
STUDIO_LLM_BASE_URL=
STUDIO_LLM_MODEL=
# 每百万 token 单价，用于 estimatedCost
STUDIO_LLM_PRICE_INPUT_PER_M=0
STUDIO_LLM_PRICE_OUTPUT_PER_M=0
# 位于反向代理之后时设为 true
STUDIO_TRUST_PROXY=false
# 服务器本地时区（日期归属）
TZ=Asia/Shanghai
