# ===== 小智 MCP 接入点 =====
# 从官方 xiaozhi.me 控制台（智能体 → 配置角色 → 意图识别 → 编辑功能 → MCP 接入点）复制
# 形如 wss://host/mcp_endpoint/mcp/?token=xxxxxx
MCP_ENDPOINT=wss://your-xiaozhi-endpoint/mcp_endpoint/mcp/?token=replace-me

# ===== Strapi 后端 =====
STRAPI_URL=http://localhost:1337
# 在 Strapi Admin → Settings → API Tokens 创建，需具备 dream 的 create 权限
STRAPI_TOKEN=replace-with-strapi-api-token

# ===== LLM 加工（OpenAI 兼容接口）=====
# 不填 LLM_API_KEY 时自动降级：仅保存梦境原文，不做 AI 加工
LLM_ENABLED=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 示例：接阿里百炼 qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-flash
# 示例：接智谱
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# ===== 运行参数 =====
LOG_LEVEL=info
RECONNECT_BASE_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=30000
