# ===== Strapi 服务器 =====
HOST=0.0.0.0
PORT=1337

# 下列密钥请用随机值替换（可执行：node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"）
# APP_KEYS 为逗号分隔的多个随机串
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=toBeModified
ADMIN_JWT_SECRET=toBeModified
TRANSFER_TOKEN_SALT=toBeModified
JWT_SECRET=toBeModified

# ===== 数据库（本地默认 SQLite）=====
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# ===== 生产用 Postgres（Task 7 切换时启用）=====
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://strapi:strapi@localhost:5432/dream_blog
# DATABASE_SSL=false

# ===== 跨域：前端部署域名，逗号分隔 =====
CORS_ORIGIN=http://localhost:3000,http://localhost:4173
